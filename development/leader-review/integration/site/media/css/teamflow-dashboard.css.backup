
:root{--navy:#14274e;--blue:#0861a7;--sidebar:#07518d;--pale:#eaf3fc;--border:#c8d8e8;--bg:#f1f6fb;--ink:#1b3051;--green:#167a43;--orange:#a96a08;--purple:#6242a4}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px Arial,sans-serif;color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer}header{height:64px;background:#fff;display:flex;align-items:center;gap:20px;padding:0 26px;border-bottom:1px solid #d5e1ed}header .logo{font-size:25px;font-weight:800;color:var(--navy);white-space:nowrap}.logo b{background:#0861a7;color:white;padding:7px 9px;border-radius:10px;margin-right:9px;font-size:21px}header .subtitle{border-left:1px solid #b7c4d3;padding-left:22px}header .account{margin-left:auto;white-space:nowrap}aside{position:fixed;width:235px;top:64px;bottom:0;background:linear-gradient(170deg,#095594,#07477c);padding:22px 9px}aside a{display:flex;gap:14px;align-items:center;color:#fff;text-decoration:none;padding:16px;border-radius:10px;font-size:17px;margin-bottom:9px}aside a.active{background:white;color:var(--navy);font-weight:bold}main{margin-left:235px;padding:24px 20px 45px;max-width:1600px}h1{font-size:31px;margin:2px 0 16px;color:#13254a}h2{font-size:21px;margin:0 0 16px;color:#14274e}.groupbar,.panel,.metric{background:white;border:1px solid var(--border);border-radius:10px}.groupbar{padding:16px;display:flex;align-items:center;gap:25px;flex-wrap:wrap;margin-bottom:14px}.groupbar span+span{border-left:1px solid #b8cadb;padding-left:25px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}.metric{display:flex;align-items:center;gap:17px;padding:18px 20px}.metric .ico{font-size:34px;color:#0b528d}.metric label{color:#31445c;display:block}.metric strong{display:block;font-size:28px;margin-top:3px}.columns{display:grid;grid-template-columns:1.55fr 1fr;gap:14px}.panel{padding:18px;margin-bottom:14px}.panelhead{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.primary{border:none;background:#0960a6;color:white;padding:10px 17px;border-radius:7px;font-weight:700}.secondary{border:1px solid #a8bcd1;background:white;color:var(--navy);padding:9px 12px;border-radius:7px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:2px 0 14px}.filters select{flex:1;min-width:140px;padding:10px;background:white;border:1px solid #b4c9dc;border-radius:7px;color:var(--ink)}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse}th{background:#d8e8fc;color:#1c2e4a}td,th{text-align:left;padding:12px 10px;border:1px solid #d5e1eb}td{background:#fff}.avatar{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:100%;background:#bed7f6;margin-right:6px;font-weight:bold}.chip{display:inline-block;padding:7px 9px;border-radius:22px;font-size:13px;white-space:nowrap}.approved{background:#ddf5e4;color:#116939}.in_progress{background:#fff0d1;color:#965e00}.pending{background:#e8ddfa;color:#60389b}.revision_required{background:#fce2e2;color:#9e2b30}.filebox{background:#eaf3ff;border-radius:10px;padding:15px;margin:8px 0 16px}.filebox b{display:block;margin-bottom:8px}.hint{color:#5c6e81;font-size:13px}textarea,input,select{max-width:100%}.reviewtext{width:100%;min-height:65px;resize:vertical;border:1px solid #bdccdc;border-radius:8px;padding:11px}.reviewactions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.approvebtn,.revisebtn{flex:1;padding:11px;border-radius:9px;font-weight:bold}.approvebtn{background:#e5f7e9;border:1px solid #1b8144;color:#136738}.revisebtn{background:#f6efff;border:1px solid #6b43aa;color:#59318c}.progress{display:grid;grid-template-columns:2fr 1fr;gap:25px;align-items:center}.progress svg{width:100%;height:auto;max-height:235px}.progress-side{text-align:center;background:#eef6ff;border-radius:12px;padding:20px}.progress-side strong{font-size:44px;color:#143f7c;display:block;margin-top:10px}.legend{margin-top:10px;font-size:13px}.legend span{display:block;margin:8px 0}.empty{background:#f2f7fc;padding:30px 12px;border-radius:10px;text-align:center;color:#63758b}.modal{position:fixed;inset:0;background:#101e34a8;display:none;align-items:center;justify-content:center;padding:15px;z-index:5}.modal.show{display:flex}.dialog{background:#fff;width:min(95vw,560px);padding:24px;border-radius:14px;box-shadow:0 16px 50px #15283a66}.dialog h2{margin:0 0 15px}.dialog label{display:block;margin-top:12px;font-weight:bold}.dialog input,.dialog select,.dialog textarea{width:100%;border:1px solid #b7c9dc;border-radius:7px;padding:10px;margin-top:5px}.dialog textarea{min-height:76px}.dialog footer{display:flex;gap:8px;justify-content:flex-end;margin-top:18px}.note{color:#4f6480;font-size:13px;margin-top:12px}.toast{position:fixed;bottom:22px;right:24px;background:#153c68;color:white;padding:13px 20px;border-radius:9px;display:none;z-index:9;max-width:390px}.toast.show{display:block}@media(max-width:1120px){.columns{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){header{padding:10px;height:auto;flex-wrap:wrap;gap:9px}.subtitle{display:none}aside{position:static;width:auto;display:flex;overflow:auto;padding:6px}aside a{min-width:max-content;padding:12px;font-size:14px;margin:0}main{margin:0;padding:15px}.metrics{grid-template-columns:repeat(2,1fr)}.metric{padding:11px;gap:7px}.metric .ico{font-size:25px}.metric strong{font-size:23px}.progress{grid-template-columns:1fr}.groupbar{gap:9px}.groupbar span+span{border:0;padding-left:0}}
