<header><span class="logo"><b>TF</b>TeamFlow</span><span class="subtitle">Quản lý bài tập nhóm</span><span class="account">🔔 3　│　🎓 Joomla　│　👤 Nhóm trưởng ▾</span></header>
<aside><a href="#">⌂　Tổng quan</a><a href="#">▤　Nhiệm vụ của tôi</a><a href="#" class="active">♧　Nhóm của tôi</a><a href="#reviews">⇩　Bài nộp</a><a href="#">⚙　Quản trị</a></aside>
<main>
<h1>♧ NHÓM CỦA TÔI</h1>
<div class="groupbar"><span><b>♧ Nhóm Joomla - TeamFlow</b></span><span>⚑ Đồ án môn Joomla</span><span>♧ 4 thành viên</span><span>▢ Hạn nhóm: 20/01/2025</span><button class="secondary" style="margin-left:auto" type="button" onclick="toast('Cài đặt nhóm thuộc Phần 1 và chưa kết nối trong bản demo.')">⚙ Cài đặt nhóm</button></div>
<div class="metrics"><div class="metric"><span class="ico">▤</span><div><label>Tổng nhiệm vụ</label><strong id="total">4</strong></div></div><div class="metric"><span class="ico">ⓥ</span><div><label>Đã hoàn thành</label><strong id="done">2</strong></div></div><div class="metric"><span class="ico">◷</span><div><label>Đang thực hiện</label><strong id="active">1</strong></div></div><div class="metric"><span class="ico">⌛</span><div><label>Chờ duyệt</label><strong id="waiting">1</strong></div></div></div>
<div class="columns"><section class="panel"><div class="panelhead"><h2>♧ Thành viên và phân công</h2><button class="primary" type="button" onclick="openDialog()">♧ Phân công</button></div><div class="filters"><select id="memberFilter" onchange="render()"><option value="">♧ Tất cả thành viên</option><option>Nguyễn Thanh</option><option>Trần Long</option><option>Phạm Trang</option><option>Lê Quang</option></select><select id="statusFilter" onchange="render()"><option value="">☑ Tất cả nhiệm vụ</option><option value="approved">Hoàn thành</option><option value="in_progress">Đang thực hiện</option><option value="pending">Chờ duyệt</option><option value="revision_required">Cần chỉnh sửa</option></select></div><div class="tablewrap"><table><thead><tr><th>Thành viên</th><th>Nhiệm vụ</th><th>Hạn hoàn thành</th><th>Trạng thái</th></tr></thead><tbody id="taskRows"></tbody></table></div></section>
<section class="panel" id="reviews"><div class="panelhead"><h2>▤ Bài chờ duyệt <span class="chip pending" id="reviewCount">1</span></h2><button class="secondary" type="button" onclick="resetDemo()">↻ Khôi phục dữ liệu demo</button></div><div id="reviewArea"></div></section></div>
<section class="panel"><div class="panelhead"><h2>▥ Tiến độ nhóm</h2><span class="hint">7 ngày gần nhất (minh họa)</span></div><div class="progress"><svg viewBox="0 0 650 215" role="img" aria-label="Biểu đồ tiến độ minh họa 7 ngày"><defs><linearGradient id="fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d1e5fa"/><stop offset="1" stop-color="#fff"/></linearGradient></defs><g stroke="#d6e2ed" stroke-width="1"><path d="M48 20H620 M48 60H620 M48 100H620 M48 140H620 M48 180H620"/></g><g font-size="12" fill="#52677d"><text x="14" y="24">100</text><text x="21" y="64">75</text><text x="21" y="104">50</text><text x="21" y="144">25</text><text x="28" y="184">0</text><text x="38" y="202">09/01</text><text x="133" y="202">10/01</text><text x="225" y="202">11/01</text><text x="320" y="202">12/01</text><text x="413" y="202">13/01</text><text x="505" y="202">14/01</text><text x="591" y="202">15/01</text></g><path d="M48 148L140 132L235 116L330 116L425 84L520 68L620 60V180H48Z" fill="url(#fill)"/><polyline points="48,148 140,132 235,116 330,116 425,84 520,68 620,60" fill="none" stroke="#176eb2" stroke-width="3"/><g fill="white" stroke="#176eb2" stroke-width="3"><circle cx="48" cy="148" r="4"/><circle cx="140" cy="132" r="4"/><circle cx="235" cy="116" r="4"/><circle cx="330" cy="116" r="4"/><circle cx="425" cy="84" r="4"/><circle cx="520" cy="68" r="4"/><circle cx="620" cy="60" r="4"/></g></svg><div><div class="progress-side">◎ Tiến độ hiện tại<strong id="percent">50%</strong></div><div class="legend" id="legend"></div></div></div><p class="note">Đường biểu đồ là dữ liệu mẫu; số liệu thống kê được tính từ các phân công trong bản demo.</p></section>
<p class="note">Bản thử nghiệm giao diện Phần 3: dữ liệu mẫu lưu trong trình duyệt trên máy này, chưa kết nối PHP, MySQL hoặc tài khoản Joomla. Có thể thay đổi trạng thái và tạo phân công để thử giao diện.</p>
</main>
<div class="modal" id="modal"><div class="dialog"><h2>Phân công công việc</h2><form id="assignForm"><label for="member">Thành viên thực hiện</label><select id="member" required><option value="">-- Chọn thành viên --</option><option>Nguyễn Thanh</option><option>Trần Long</option><option>Phạm Trang</option><option>Lê Quang</option></select><label for="task_group_id">Nhiệm vụ của nhóm</label><select id="task_group_id" required><option value="1">Bài tập nhóm số 1</option><option value="2">Bài tập nhóm số 2</option></select><label for="title">Tên công việc</label><input id="title" required maxlength="255" placeholder="Ví dụ: Thiết kế giao diện"><label for="description">Mô tả</label><textarea id="description"></textarea><label for="due_at">Hạn hoàn thành (demo)</label><input type="date" id="due_at" required><footer><button type="button" class="secondary" onclick="closeDialog()">Hủy</button><button class="primary" type="submit">Giao nhiệm vụ</button></footer></form></div></div><div class="toast" id="toast" role="status"></div>
<script>
const KEY='teamflow-leader-review-demo-v1';const seed={tasks:[{id:1,member:'Nguyễn Thanh',title:'Thiết kế giao diện',due_at:'2025-01-10',status:'approved'},{id:2,member:'Trần Long',title:'Xây dựng chức năng',due_at:'2025-01-15',status:'in_progress'},{id:3,member:'Phạm Trang',title:'Viết báo cáo',due_at:'2025-01-18',status:'pending'},{id:4,member:'Lê Quang',title:'Kiểm thử và hoàn thiện',due_at:'2025-01-20',status:'approved'}],submissions:[{id:1,taskId:3,file:'chucnang-joomla.zip',size:'4,2 MB',submitted_at:'15/01/2025 09:30',review_status:'pending',review_comment:''}]};
let state;try{state=JSON.parse(localStorage.getItem(KEY))||structuredClone(seed)}catch{state=structuredClone(seed)};function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch{}}function text(el,value){el.textContent=value}function el(tag,cls,value){const node=document.createElement(tag);if(cls)node.className=cls;if(value!==undefined)text(node,value);return node}function statusLabel(s){return({approved:'✓ Hoàn thành',in_progress:'◷ Đang thực hiện',pending:'⌛ Chờ duyệt',revision_required:'✎ Cần chỉnh sửa'})[s]||s}function dateStr(s){if(!s)return'—';const[a,b,c]=s.split('-');return `${c}/${b}/${a}`}function toast(msg){const n=document.getElementById('toast');n.textContent=msg;n.classList.add('show');clearTimeout(window.toastTimeout);window.toastTimeout=setTimeout(()=>n.classList.remove('show'),3600)}
function render(){const tasks=state.tasks;const done=tasks.filter(t=>t.status==='approved').length;const active=tasks.filter(t=>t.status==='in_progress').length;const pending=tasks.filter(t=>t.status==='pending').length;text(document.getElementById('total'),tasks.length);text(document.getElementById('done'),done);text(document.getElementById('active'),active);text(document.getElementById('waiting'),pending);text(document.getElementById('percent'),Math.round(done/Math.max(1,tasks.length)*100)+'%');const legend=document.getElementById('legend');legend.replaceChildren();[['✓ Đã hoàn thành',done],['◷ Đang thực hiện',active],['⌛ Chờ duyệt',pending],['✎ Cần chỉnh sửa',tasks.filter(t=>t.status==='revision_required').length]].forEach(([label,n])=>legend.appendChild(el('span','',`${label}: ${n} (${Math.round(n/Math.max(1,tasks.length)*100)}%)`)));const rows=document.getElementById('taskRows');rows.replaceChildren();const member=document.getElementById('memberFilter').value,status=document.getElementById('statusFilter').value;tasks.filter(t=>(!member||member===t.member)&&(!status||status===t.status)).forEach(t=>{const tr=el('tr');const a=el('td');const avatar=el('span','avatar',t.member.split(' ').map(x=>x[0]).slice(-2).join(''));a.appendChild(avatar);a.append(document.createTextNode(t.member));tr.appendChild(a);tr.appendChild(el('td','',t.title));tr.appendChild(el('td','',dateStr(t.due_at)));const d=el('td');d.appendChild(el('span','chip '+t.status,statusLabel(t.status)));tr.appendChild(d);rows.appendChild(tr)});if(!rows.children.length){const tr=el('tr'),td=el('td','','Không có công việc phù hợp');td.colSpan=4;tr.appendChild(td);rows.appendChild(tr)}renderReviews()}
function renderReviews(){const pending=state.submissions.filter(s=>s.review_status==='pending');text(document.getElementById('reviewCount'),String(pending.length));const area=document.getElementById('reviewArea');area.replaceChildren();if(!pending.length){area.appendChild(el('div','empty','Không có bài đang chờ duyệt.'));return}pending.forEach(s=>{const box=el('div');box.appendChild(el('div','filebox',`▤ ${s.file}\n${s.size}  |  ${s.submitted_at}`));box.appendChild(el('label','', 'Nhận xét'));const comment=el('textarea','reviewtext');comment.placeholder='Nhập nhận xét bài nộp';comment.value=s.review_comment||'';box.appendChild(comment);const actions=el('div','reviewactions');const approve=el('button','approvebtn','✓ Đạt'),revise=el('button','revisebtn','✎ Yêu cầu chỉnh sửa');approve.type=revise.type='button';approve.addEventListener('click',()=>review(s.id,'approved',comment.value));revise.addEventListener('click',()=>review(s.id,'revision_required',comment.value));actions.append(approve,revise);box.appendChild(actions);area.appendChild(box)})}
function review(id,review_status,review_comment){if(review_status==='revision_required'&&!review_comment.trim()){toast('Vui lòng nhập nhận xét khi yêu cầu chỉnh sửa.');return}const s=state.submissions.find(x=>x.id===id);if(!s||s.review_status!=='pending'){toast('Bài nộp không còn ở trạng thái chờ duyệt.');return}s.review_status=review_status;s.review_comment=review_comment.trim();const t=state.tasks.find(x=>x.id===s.taskId);if(t)t.status=review_status;save();render();toast(review_status==='approved'?'Đã đánh dấu Đạt (demo).':'Đã yêu cầu chỉnh sửa (demo).')}
function resetDemo(){if(!confirm('Khôi phục dữ liệu mẫu? Các phân công và đánh giá thử nghiệm trong trang demo này sẽ bị xóa.'))return;localStorage.removeItem(KEY);state=structuredClone(seed);document.getElementById('memberFilter').value='';document.getElementById('statusFilter').value='';render();toast('Đã khôi phục bài chờ duyệt mẫu.')}
function openDialog(){document.getElementById('modal').classList.add('show');document.getElementById('member').focus()}function closeDialog(){document.getElementById('modal').classList.remove('show')}document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeDialog()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDialog()});document.getElementById('assignForm').addEventListener('submit',e=>{e.preventDefault();const member=document.getElementById('member').value,title=document.getElementById('title').value.trim(),due_at=document.getElementById('due_at').value;if(!member||!title||!due_at){toast('Vui lòng nhập đủ thông tin.');return}state.tasks.push({id:Math.max(0,...state.tasks.map(x=>x.id))+1,member,title,due_at,description:document.getElementById('description').value,task_group_id:Number(document.getElementById('task_group_id').value),status:'in_progress'});save();render();e.target.reset();closeDialog();toast('Đã thêm phân công vào bản demo.')});render();
</script>